{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/hook.mjs\" --inject",
            "statusMessage": "Connecting Goal Viewer"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/hook.mjs\" --inject",
            "statusMessage": "Updating Goal Viewer"
          }
        ]
      }
    ]
  }
}
